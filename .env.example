# Nashwa example environment file
# Copy this to `.env` and fill in real values. DO NOT commit sensitive secrets.

# Database (Postgres)
DATABASE_URL=postgresql://dbuser:dbpass@localhost:5432/nashwa_db

# OpenRouter (AI provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override default URL/model
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-instruct:free

# SMTP (used for verification emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="Nashwa <no-reply@example.com>"

# Cloudinary (if used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT / Sessions
JWT_SECRET=replace_with_a_secure_random_string

# Public base URL (used by some server-side links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
